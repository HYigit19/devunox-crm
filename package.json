{
  "name": "devunox-crm",
  "version": "1.0.0",
  "description": "Devunox CRM – Angebote, CRM, Gmail-Versand und KI-Vertriebsagent auf Cloudflare",
  "scripts": {
    "dev:ui": "vite",
    "build:ui": "vite build",
    "dev": "npm run build:ui && wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "pdf-lib": "^1.17.1",
    "read-excel-file": "^9.3.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "private": true,
  "type": "module"
}
